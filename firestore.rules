rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read:
        if request.auth != null
        && request.auth.uid == userId;

      allow create:
        if isTherapist()
        && existsAfter(
          /databases/$(database)/documents/therapists/$(request.auth.uid)/patients/$(userId)
        )
        && request.resource.data.keys().hasOnly([
          'role',
          'mustChangePassword'
        ])
        && request.resource.data.role == 'PATIENT'
        && request.resource.data.mustChangePassword == true;

      allow update:
        if request.auth != null
        && request.auth.uid == userId
        && resource.data.role == 'PATIENT'
        && resource.data.mustChangePassword == true
        && request.resource.data.keys().hasOnly([
          'role',
          'mustChangePassword'
        ])
        && request.resource.data.role == 'PATIENT'
        && request.resource.data.mustChangePassword == false;

      allow delete:
        if false;
    }

    match /therapists/{therapistId}/patients/{patientId} {
      allow read:
        if request.auth != null
        && request.auth.uid == therapistId;

      allow create, update:
        if isTherapist()
        && request.auth.uid == therapistId
        && request.resource.data.keys().hasOnly([
          'active',
          'displayName'
        ])
        && request.resource.data.active == true;

      allow delete:
        if false;
    }

    match /patients/{patientId}/exerciseSessions/{sessionId} {
      allow read:
        if isPatientOwner(patientId)
        || isAssignedTherapist(patientId);

      allow create, update:
        if isPatientOwner(patientId)
        && request.resource.data.patientId == patientId
        && request.resource.data.id == sessionId
        && request.resource.data.keys().hasOnly([
          'id',
          'assignmentId',
          'patientId',
          'startedAtEpochMillis',
          'completedAtEpochMillis',
          'sessionStatus',
          'completedRepetitions',
          'minimumKneeAngleDegrees',
          'maximumKneeAngleDegrees'
        ]);

      allow delete:
        if false;
    }

    match /patients/{patientId}/exerciseAssignments/{assignmentId} {
      allow read:
        if isPatientOwner(patientId)
        || isAssignedTherapist(patientId);

      allow create, update:
        if isAssignedTherapist(patientId)
        && request.resource.data.patientId == patientId
        && request.resource.data.id == assignmentId;

      allow delete:
        if false;
    }

    function isPatientOwner(patientId) {
      return request.auth != null
        && request.auth.uid == patientId;
    }

    function isTherapist() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'THERAPIST';
    }

    function isAssignedTherapist(patientId) {
      return isTherapist()
        && exists(
          /databases/$(database)/documents/therapists/$(request.auth.uid)/patients/$(patientId)
        );
    }
  }
}
